{
  "name": "lablend",
  "version": "1.0.0",
  "description": "LabLend - university lab equipment loan management system",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node scripts/seed.js",
    "test": "jest --runInBand"
  },
  "engines": {
    "node": ">=20 <21"
  },
  "dependencies": {
    "axios": "^1.21.1",
    "bcrypt": "5.1.0",
    "better-sqlite3": "9.1.1",
    "csv-stringify": "6.4.0",
    "ejs": "3.1.9",
    "express": "4.22.3",
    "express-session": "1.17.3",
    "jsonwebtoken": "9.0.0",
    "lodash": "4.17.21",
    "marked": "4.3.0",
    "morgan": "1.10.0",
    "multer": "2.5.0"
  },
  "devDependencies": {
    "jest": "29.5.0",
    "supertest": "6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setupEnv.js"
    ]
  }
}
