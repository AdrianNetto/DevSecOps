<%- include('../partials/header') %>
<section class="card">
  <h1><%= title %></h1>
  <form method="post" action="<%= action %>" enctype="multipart/form-data" class="form">
    <label>Name <input type="text" name="name" value="<%= item.name %>" required></label>
    <label>Category <input type="text" name="category" value="<%= item.category %>" list="categories" required></label>
    <datalist id="categories">
      <option value="Oscilloscope"><option value="Multimeter"><option value="Microcontroller Kit">
      <option value="3D Printer"><option value="Power Supply"><option value="Signal Generator">
    </datalist>
    <label>Serial number <input type="text" name="serial_number" value="<%= item.serial_number %>" required></label>
    <label>Status
      <% if (item.status === 'LOANED') { %>
        <input type="text" value="LOANED (changes on return)" disabled>
        <input type="hidden" name="status" value="AVAILABLE">
      <% } else { %>
      <select name="status">
        <% statuses.forEach(function (s) { %>
          <option value="<%= s %>" <%= item.status === s ? 'selected' : '' %>><%= s %></option>
        <% }) %>
      </select>
      <% } %>
    </label>
    <label>Description (Markdown)
      <textarea name="description" rows="10" id="description"><%= item.description %></textarea>
    </label>
    <label>Photo <small class="muted">(JPG or PNG, max 2 MB)</small>
      <input type="file" name="photo" accept="image/jpeg,image/png" data-max-bytes="2097152">
    </label>
    <% if (item.photo_path) { %><img class="thumb" src="<%= item.photo_path %>" alt="current photo"><% } %>
    <div class="form-actions">
      <button class="btn btn-primary">Save</button>
      <a class="btn" href="<%= item.id ? '/equipment/' + item.id : '/equipment' %>">Cancel</a>
    </div>
  </form>
</section>
<%- include('../partials/footer') %>
