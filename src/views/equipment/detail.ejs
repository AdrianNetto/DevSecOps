<%- include('../partials/header') %>
<div class="page-head">
  <h1><%= item.name %></h1>
  <div>
    <% if (item.status !== 'MAINTENANCE') { %>
      <a class="btn btn-primary" href="/loans/new?equipmentId=<%= item.id %>">Request loan</a>
    <% } %>
    <% if (['TECHNICIAN', 'ADMIN'].includes(currentUser.role)) { %>
      <a class="btn" href="/equipment/<%= item.id %>/edit">Edit</a>
      <form method="post" action="/equipment/<%= item.id %>/delete" class="inline" data-confirm="Delete this equipment?">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn btn-danger">Delete</button>
      </form>
    <% } %>
  </div>
</div>
<section class="card detail">
  <div class="detail-media">
    <% if (item.photo_path) { %>
      <img src="<%= item.photo_path %>" alt="<%= item.name %>">
    <% } else { %>
      <div class="placeholder large"><%= item.category %></div>
    <% } %>
  </div>
  <div class="detail-body">
    <dl class="meta">
      <dt>Category</dt><dd><%= item.category %></dd>
      <dt>Serial number</dt><dd><code><%= item.serial_number %></code></dd>
      <dt>Status</dt><dd><span class="badge badge-eq-<%= item.status.toLowerCase() %>"><%= item.status %></span></dd>
      <dt>Added</dt><dd><%= item.created_at %></dd>
    </dl>
    <div class="markdown"><%- item.descriptionHtml %></div>
  </div>
</section>
<%- include('../partials/footer') %>
