<%- include('partials/header') %>
<section class="card narrow">
  <h1>Profile</h1>
  <dl class="meta">
    <dt>Email</dt><dd><%= currentUser.email %></dd>
    <dt>Role</dt><dd><%= currentUser.role %></dd>
    <dt>Member since</dt><dd><%= currentUser.created_at %></dd>
  </dl>
  <form method="post" action="/profile" class="form">
    <label>Name <input type="text" name="name" value="<%= currentUser.name %>" required></label>
    <label>Preferences (JSON — merged into your saved preferences)
      <textarea name="preferences" rows="10" id="preferences" class="mono"><%= preferences %></textarea>
    </label>
    <p class="muted">Example: <code>{"notifications": {"email": true}, "theme": "dark"}</code></p>
    <button class="btn btn-primary">Save</button>
  </form>
</section>
<%- include('partials/footer') %>
