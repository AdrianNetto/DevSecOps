<%- include('../partials/header') %>
<section class="card narrow">
  <h1>Request a loan</h1>
  <p class="muted">Loans last 1 to 14 days. If the due date falls on a weekend or public holiday it is moved to the next business day.</p>
  <form method="post" action="/loans" class="form" id="loan-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>Equipment
      <select name="equipment_id" required>
        <option value="">Select…</option>
        <% equipment.forEach(function (e) { %>
          <option value="<%= e.id %>" <%= String(form.equipment_id) === String(e.id) ? 'selected' : '' %>><%= e.name %> (<%= e.serial_number %>)<%= e.status === 'LOANED' ? ' — currently loaned' : '' %></option>
        <% }) %>
      </select>
    </label>
    <label>Start date <input type="date" name="requested_start" value="<%= form.requested_start %>" min="<%= form.requested_start %>" required></label>
    <label>Due date <input type="date" name="due_date" value="<%= form.due_date %>" required></label>
    <p class="muted" id="duration-hint"></p>
    <label>Notes <textarea name="notes" rows="3" maxlength="1000"><%= form.notes %></textarea></label>
    <button class="btn btn-primary">Submit request</button>
  </form>
</section>
<%- include('../partials/footer') %>
